# Docker Compose environment — used by api, scheduler, and worker services
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_scheduler
REDIS_URL=redis://redis:6379/1
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string

MAX_RETRIES=3
VISIBILITY_TIMEOUT=30
WORKER_POLL_TIMEOUT=5
RATE_LIMIT_WINDOW=60
BASE_RETRY_DELAY=2
JOB_EXECUTION_TIMEOUT=120
CORS_ORIGINS=http://localhost:3000
