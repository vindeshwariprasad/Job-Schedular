# ─── Required ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/job_scheduler
REDIS_URL=redis://localhost:6379/1
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string

# ─── Optional (defaults shown) ──────────────────────
MAX_RETRIES=3
VISIBILITY_TIMEOUT=30
WORKER_POLL_TIMEOUT=5
RATE_LIMIT_WINDOW=60
BASE_RETRY_DELAY=2
JOB_EXECUTION_TIMEOUT=120
CORS_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=120

# ─── Circuit Breaker ──────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_STATE_TTL=3600
CIRCUIT_MAX_OPEN_RETRIES=10
